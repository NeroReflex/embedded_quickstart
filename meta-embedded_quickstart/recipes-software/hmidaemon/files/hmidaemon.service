[Unit]
Description=HMI Daemon Service
After=network.target
ConditionPathExists=/mnt/app/hmi_daemon

[Service]
User=hmidaemon
EnvironmentFile=/mnt/app/hmidaemon.env
ExecStartPre=+chown -R hmidaemon:hmidaemon /mnt/app_data/current
ExecStart=-/usr/bin/sh -c "/mnt/app/hmi_daemon"

[Install]
WantedBy=multi-user.target
